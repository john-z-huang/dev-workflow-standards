    "validate:stdio": "node dist/validate-stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^24.10.0",
    "typescript": "^6.0.3"
  }
}
