{
  "name": "dev-workflow-standards-mcp-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codex-only TypeScript MCP v2 tools for dev-workflow-standards",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
